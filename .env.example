# غيّر القيم قبل أول تشغيل. لا ترفع ملف .env إلى GitHub.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password

# مفتاح مستقل بطول 32 حرفًا على الأقل لتشفير روابط الكاميرات على القرص.
DATA_ENCRYPTION_KEY=change-this-to-another-long-random-secret-key

WEB_PORT=8080

# true عند تشغيل الموقع خلف HTTPS. في الشبكة المحلية عبر HTTP اتركها false.
SECURE_COOKIES=false

# اختياري
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# عنوان داخلي، لا تغيّره عند استخدام docker-compose المرفق.
GO2RTC_URL=http://go2rtc:1984
